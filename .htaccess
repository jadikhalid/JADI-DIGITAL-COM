# Bloque l’accès HTTP aux secrets et fichiers sensibles
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<IfModule mod_authz_core.c>
  <Files ".env">
    Require all denied
  </Files>
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  <Files ".env">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>
